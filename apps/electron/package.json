{
  "name": "@u15/electron",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && node dev.js",
    "build": "tsc",
    "build:win": "pnpm build && pnpm build:backend && pnpm build:frontend && node scripts/fetch-python.mjs && electron-builder --win",
    "build:backend": "pnpm --filter @u15/backend build",
    "build:frontend": "pnpm --filter @u15/frontend build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.61.1",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "jp.u15.server",
    "productName": "U15 Server Maizuru",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**",
      "!dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend/dist",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "vendor/python",
        "to": "python"
      }
    ]
  }
}
